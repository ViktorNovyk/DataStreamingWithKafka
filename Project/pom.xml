<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>4.0.6</version>
        <relativePath/>
    </parent>

    <groupId>ua.edu.ucu.ds.kafka</groupId>
    <artifactId>reddit-pipeline</artifactId>
    <version>0.0.1-SNAPSHOT</version>
    <packaging>pom</packaging>
    <name>reddit-pipeline</name>
    <description>Kafka social media data processing pipeline</description>

    <modules>
        <module>csv-producer</module>
        <module>language-detection-service</module>
        <module>sentiment-detection-service</module>
        <module>keyword-service</module>
        <module>statistics-service</module>
    </modules>

    <properties>
        <java.version>25</java.version>
        <jib-maven-plugin.version>3.5.1</jib-maven-plugin.version>
        <univocity-parsers.version>2.9.1</univocity-parsers.version>
        <java-uuid-generator.version>5.2.0</java-uuid-generator.version>
        <opennlp.version>2.5.5</opennlp.version>
        <lucene.version>10.3.1</lucene.version>
        <onnxruntime.version>1.23.0</onnxruntime.version>
        <djl.version>0.34.0</djl.version>
    </properties>

    <build>
        <pluginManagement>
            <plugins>
                <plugin>
                    <groupId>com.google.cloud.tools</groupId>
                    <artifactId>jib-maven-plugin</artifactId>
                    <version>${jib-maven-plugin.version}</version>
                    <configuration>
                        <from>
                            <image>eclipse-temurin:25-jre</image>
                            <platforms>
                                <platform>
                                    <architecture>arm64</architecture>
                                    <os>linux</os>
                                </platform>
                            </platforms>
                        </from>
                    </configuration>
                </plugin>
            </plugins>
        </pluginManagement>
    </build>
</project>
